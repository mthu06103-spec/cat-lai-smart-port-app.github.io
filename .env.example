# ===================================
# Environment Configuration
# Cảng Container Thông Minh Cát Lái
# ===================================

# Backend API
DEBUG=True
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Security
JWT_SECRET_KEY=your-secret-key-change-in-production-cat-lai-2024
AES_ENCRYPTION_KEY=your-aes-key-256-bit-encryption

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cat_lai_port
DB_USER=portadmin
DB_PASSWORD=portpassword123

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# 5G Network
NETWORK_LATENCY_MS=10
DATA_TRANSMISSION_RATE_MBPS=100

# LiDAR Settings
LIDAR_FREQUENCY_HZ=100
LIDAR_ACCURACY_MM=2.0

# Simulation
RANDOM_SEED=42
SIMULATION_DURATION_HOURS=24

# Frontend
API_BASE_URL=http://localhost:8000
STREAMLIT_SERVER_PORT=8501

# Logging
LOG_LEVEL=INFO
